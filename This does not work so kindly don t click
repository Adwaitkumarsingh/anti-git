    function renderInstitutions() {
      const container = document.getElementById('institutionsList');
      if (APP_STATE.data.institutions.length === 0) {
        container.innerHTML = '<div class="info-box">No institutions added yet. Click the button below to add your school or academy.</div>';
        return;
      }

      container.innerHTML = APP_STATE.data.institutions.map(inst => `
        <div class="institution-card">
          <div class="institution-header">
            <div>
              <div class="institution-name">📚 ${inst.name}</div>
              <div class="institution-time">${inst.type.toUpperCase()} • ${formatTime(inst.startTime)} - ${formatTime(inst.endTime)}</div>
              <small style="color: var(--text-dim); font-family: var(--font-mono); display: block; margin-top: 4px;">Working Days: ${inst.workdays.join(', ')}</small>
              <small style="color: ${inst.travelMins != null ? 'var(--text-dim)' : 'var(--neon-pink)'}; font-family: var(--font-mono); display: block; margin-top: 2px;">🚗 ${inst.travelMins != null ? inst.travelMins : 0} min travel each way${inst.travelMins == null ? ' — click Edit to set this' : ''}</small>
            </div>
            <div style="display: flex; flex-direction: column; gap: 6px;">
              <button onclick="openEditInstitutionModal(${inst.id})">
                <i class="fas fa-pen"></i> Edit
              </button>
              <button class="remove-btn" onclick="removeInstitution(${inst.id})">
                <i class="fas fa-trash"></i> Remove
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    // ==================== Generate Timetable Function ====================
    // Returns true if [startMins, startMins+durationMins) overlaps any existing item.
    // Times are treated on a 0-1440 axis; a second "day" (1440-2880) is appended so
    // that sleep windows crossing midnight can be checked correctly.
    function hasConflict(items, startMins, durationMins) {
      const endMins = startMins + durationMins;
      return items.some(it => {
        const itEnd = it.startMins + it.durationMins;
        return startMins < itEnd && endMins > it.startMins;
      });
    }

    // Finds the first free gap of at least `neededMins` within [dayStart, dayEnd),
    // searching candidate start points just after each existing item (and at dayStart).
    // If `deadline` is given, the slot must END by that time (e.g. breakfast must
    // finish before school starts) — later candidates are excluded entirely.
    function findFreeSlot(items, neededMins, dayStart, dayEnd, preferredStart, deadline) {
      const effectiveEnd = deadline !== undefined ? Math.min(dayEnd, deadline) : dayEnd;

      const candidates = [dayStart, ...items.map(it => it.startMins + it.durationMins)]
        .filter(t => t >= dayStart && t + neededMins <= effectiveEnd)
        .sort((a, b) => a - b);

      // Prefer a candidate close to the preferred time if it's conflict-free
      if (preferredStart !== undefined &&
          preferredStart >= dayStart &&
          preferredStart + neededMins <= effectiveEnd &&
          !hasConflict(items, preferredStart, neededMins)) {
        return preferredStart;
      }

      for (const start of candidates) {
        if (!hasConflict(items, start, neededMins)) {
          return start;
        }
      }
      return null; // no room found
    }

    // Returns every free gap within [dayStart, dayEnd), in chronological order.
    // Used for activities (like study) that can be split across multiple sittings
    // instead of needing one single unbroken block.
    function findAllFreeGaps(items, dayStart, dayEnd) {
      const sorted = [...items].sort((a, b) => a.startMins - b.startMins);
      const gaps = [];
      let cursor = dayStart;
      sorted.forEach(it => {
        const itStart = Math.max(it.startMins, dayStart);
        const itEnd = it.startMins + it.durationMins;
        if (itStart > cursor) {
          gaps.push({ start: cursor, end: Math.min(itStart, dayEnd) });
        }
        cursor = Math.max(cursor, itEnd);
      });
      if (cursor < dayEnd) gaps.push({ start: cursor, end: dayEnd });
      return gaps.filter(g => g.end > g.start);
    }

    // Builds one day's schedule as a pure function (no APP_STATE writes) so it can be
    // reused both by the real generator and by the Smart Fit Assistant's live preview.
    //
    // Strategy: sleep + academy are fixed and non-negotiable. Everything else is
    // "flexible" and has an ideal duration and a minimum viable duration. If the day
    // doesn't have room for everything at ideal length, we trim the LEAST important
    // things first (free time, then dinner/lunch, then breakfast/morning routine) down
    // to their minimums before ever touching study time. Only if the day still doesn't
    // have room after every other trim do we reduce study time itself — and we report
    // exactly how far short it fell, so the app can flag it instead of silently failing.
    function buildDaySchedule(day, wakeMins, sleepMins, studyTargetMins, institutions) {
      const items = [];

      // Sleep (ends at wake time; a negative start just means it began before midnight)
      const sleepStartMins = wakeMins - sleepMins;
      items.push({ activity: '😴 Sleep', startMins: sleepStartMins, durationMins: sleepMins, fixed: true });

      const dayStart = wakeMins;
      const dayEnd = wakeMins + (24 * 60 - sleepMins);
      let blockedMinutesInRange = 0;
      let earliestDeparture = null; // the time you must be OUT THE DOOR, accounting for commute

      institutions.forEach(inst => {
        if (inst.workdays.includes(day)) {
          const [startH, startM] = inst.startTime.split(':').map(Number);
          const [endH, endM] = inst.endTime.split(':').map(Number);
          let startMins = startH * 60 + startM;
          let endMins = endH * 60 + endM;
          if (endMins <= startMins) endMins += 24 * 60; // overnight academy
          const travelMins = Math.max(0, inst.travelMins || 0);

          items.push({ activity: `🏫 ${inst.name}`, startMins, durationMins: endMins - startMins, fixed: true });

          if (travelMins > 0) {
            items.push({ activity: `🚗 Commute to ${inst.name}`, startMins: startMins - travelMins, durationMins: travelMins, fixed: true });
            items.push({ activity: `🚗 Commute back from ${inst.name}`, startMins: endMins, durationMins: travelMins, fixed: true });
          }

          const departureMins = startMins - travelMins;
          if (earliestDeparture === null || departureMins < earliestDeparture) {
            earliestDeparture = departureMins;
          }
        }
      });

      // Total blocked time (school + commute both ways) that falls inside the waking window
      items.forEach(it => {
        if (it.fixed && it.activity !== '😴 Sleep') {
          const overlapStart = Math.max(it.startMins, dayStart);
          const overlapEnd = Math.min(it.startMins + it.durationMins, dayEnd);
          if (overlapEnd > overlapStart) blockedMinutesInRange += (overlapEnd - overlapStart);
        }
      });

      const freeMinutesTotal = Math.max(0, (dayEnd - dayStart) - blockedMinutesInRange);

      // Trim order: index 0 gets shrunk first (most flexible), study is always last.
      const specs = [
        { key: 'freetime', activity: '🎮 Free Time/Recreation', ideal: 60, min: 0, preferredStart: 17 * 60 },
        { key: 'dinner', activity: '🍜 Dinner', ideal: 45, min: 20, preferredStart: 19 * 60 },
        { key: 'lunch', activity: '🍽️ Lunch & Break', ideal: 60, min: 25, preferredStart: 13 * 60 },
        { key: 'breakfast', activity: '🍳 Breakfast', ideal: 30, min: 15, preferredStart: wakeMins + 60, beforeSchool: true },
        { key: 'morning', activity: '🌅 Morning Routine', ideal: 60, min: 20, preferredStart: wakeMins, beforeSchool: true },
        { key: 'study', activity: '📚 Personal Study/Homework', ideal: studyTargetMins, min: studyTargetMins, preferredStart: 20 * 60 }
      ];

      const actual = {};
      specs.forEach(s => { actual[s.key] = s.ideal; });

      let shortfall = specs.reduce((sum, s) => sum + s.ideal, 0) - freeMinutesTotal;

      if (shortfall > 0) {
        for (const s of specs) {
          if (shortfall <= 0) break;
          const reducible = actual[s.key] - s.min;
          if (reducible <= 0) continue;
          const reduceBy = Math.min(reducible, shortfall);
          actual[s.key] -= reduceBy;
          shortfall -= reduceBy;
        }
      }

      // Only reached if even every non-study minimum plus zero free time still doesn't fit
      let studyShortfallMins = 0;
      if (shortfall > 0) {
        const cut = Math.min(actual.study, shortfall);
        actual.study -= cut;
        studyShortfallMins = cut;
        shortfall -= cut;
      }

      const singleBlockOrder = ['morning', 'breakfast', 'lunch', 'freetime', 'dinner'];
      const conflicts = [];
      const trimmedList = [];

      singleBlockOrder.forEach(key => {
        const spec = specs.find(s => s.key === key);
        const duration = actual[key];
        if (duration <= 0) {
          if (spec.ideal > 0) trimmedList.push(`${spec.activity} was skipped today to make room for study time.`);
          return;
        }

        const deadline = spec.beforeSchool && earliestDeparture !== null ? Math.max(dayStart, earliestDeparture) : undefined;
        let slot = findFreeSlot(items, duration, dayStart, dayEnd, spec.preferredStart, deadline);
        let missedDeadline = false;

        if (slot === null && deadline !== undefined) {
          // Couldn't fit before school even with everything else already placed —
          // fall back to placing it later in the day, but flag it so it's obvious.
          slot = findFreeSlot(items, duration, dayStart, dayEnd, spec.preferredStart);
          missedDeadline = slot !== null;
        }

        if (slot !== null) {
          items.push({ activity: spec.activity, startMins: slot, durationMins: duration, fixed: false });
          if (duration < spec.ideal) {
            trimmedList.push(`${spec.activity} trimmed from ${(spec.ideal / 60).toFixed(1)}h to ${(duration / 60).toFixed(1)}h to fit your day.`);
          }
          if (missedDeadline) {
            trimmedList.push(`${spec.activity} couldn't fit before you need to leave today, so it was moved later — consider waking up a bit earlier.`);
          }
        } else {
          conflicts.push(`Couldn't place "${spec.activity}" (${(duration / 60).toFixed(1)}h) — today's schedule is too fragmented to fit it anywhere.`);
        }
      });

      // Study time doesn't need one unbroken block — real study happens in sessions.
      // Fill whatever free gaps remain, in time order, until the target is met.
      const studySpec = specs.find(s => s.key === 'study');
      let studyNeeded = actual.study;
      if (studyNeeded > 0) {
        const gaps = findAllFreeGaps(items, dayStart, dayEnd);
        const sessions = [];
        for (const gap of gaps) {
          if (studyNeeded <= 0) break;
          const gapLen = gap.end - gap.start;
          const use = Math.min(gapLen, studyNeeded);
          if (use > 0) {
            sessions.push({ start: gap.start, durationMins: use });
            studyNeeded -= use;
          }
        }
        sessions.forEach((s, idx) => {
          const label = sessions.length > 1 ? `📚 Study Session ${idx + 1}` : studySpec.activity;
          items.push({ activity: label, startMins: s.start, durationMins: s.durationMins, fixed: false });
        });
        if (sessions.length > 1) {
          trimmedList.push(`Study time was split into ${sessions.length} sessions across free gaps in your day.`);
        }
        if (studyNeeded > 0) {
          conflicts.push(`Only fit ${((actual.study - studyNeeded) / 60).toFixed(1)}h of ${(actual.study / 60).toFixed(1)}h of study time — no free gaps left today.`);
        }
      }

      return { items, conflicts, trimmedList, studyIdealMins: studyTargetMins, studyActualMins: actual.study, studyShortfallMins, freeMinutesTotal };
    }

    function generateTimetable() {
      if (APP_STATE.data.institutions.length === 0) {
        document.getElementById('generatedScheduleContainer').style.display = 'none';
        document.getElementById('noScheduleMessage').style.display = 'block';
        document.getElementById('regenerateBtn').style.display = 'none';
        document.getElementById('smartFitBanner').style.display = 'none';
        return;
      }

      const schedule = {};
      const conflicts = {};
      const trims = {};
      const studyShortfalls = {};
      const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

      const wakeTimeStr = APP_STATE.data.preferences.wakeTime;
      const [wakeH, wakeM] = wakeTimeStr.split(':').map(Number);
      const wakeMins = wakeH * 60 + wakeM;
      const sleepMins = APP_STATE.data.preferences.sleepHours * 60;

      days.forEach(day => {
        // Respect the per-day study hours set in "Edit Weekly Schedule" if present,
        // falling back to the flat daily target otherwise.
        const dayTargetHours = (APP_STATE.data.timetable[day] && APP_STATE.data.timetable[day].studyHours != null)
          ? APP_STATE.data.timetable[day].studyHours
          : APP_STATE.data.preferences.studyTarget;
        const studyTargetMins = dayTargetHours * 60;

        const result = buildDaySchedule(day, wakeMins, sleepMins, studyTargetMins, APP_STATE.data.institutions);
        schedule[day] = result.items;
        conflicts[day] = result.conflicts;
        trims[day] = result.trimmedList;
        studyShortfalls[day] = result.studyShortfallMins;
      });

      APP_STATE.generatedSchedule = schedule;
      APP_STATE.scheduleConflicts = conflicts;
      APP_STATE.scheduleTrims = trims;
      APP_STATE.studyShortfalls = studyShortfalls;
      saveStateToLocalStorage();
      renderGeneratedSchedule(schedule, conflicts, trims, studyShortfalls);
    }

    function renderGeneratedSchedule(schedule, conflicts, trims, studyShortfalls) {
      const container = document.getElementById('generatedScheduleContainer');
      const banner = document.getElementById('smartFitBanner');
      const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

      const shortDays = days.filter(d => (studyShortfalls[d] || 0) > 0);
      if (shortDays.length > 0) {
        const list = shortDays.map(d => `${d} (short by ${(studyShortfalls[d] / 60).toFixed(1)}h)`).join(', ');
        banner.innerHTML = `
          <div class="info-box" style="background: rgba(255, 45, 149, 0.12); border-left-color: var(--neon-pink);">
            <strong>⚠️ Your full study target doesn't fit on: ${list}.</strong><br>
            Everything else has already been trimmed to its minimum. Open the Smart Fit Assistant to adjust your wake time, sleep hours, or study target until it fits.
          </div>
          <button style="margin-top: 10px; width: 100%;" onclick="openSmartFitModal()">
            <i class="fas fa-wand-magic-sparkles"></i> Open Smart Fit Assistant
          </button>
        `;
        banner.style.display = 'block';
      } else {
        banner.style.display = 'none';
        banner.innerHTML = '';
      }

      let html = '<div style="margin-top: 20px;">';

      days.forEach(day => {
        const daySchedule = schedule[day];
        daySchedule.sort((a, b) => a.startMins - b.startMins);

        html += `
          <div style="margin-bottom: 30px; padding: 15px; background: rgba(8, 3, 16, 0.55); border: 1px solid rgba(167, 66, 255, 0.2); border-radius: 8px;">
            <h3 style="color: var(--neon-cyan); margin-bottom: 15px; font-family: var(--font-head); text-transform: uppercase; letter-spacing: 1px; text-shadow: 0 0 6px rgba(0, 229, 255, 0.4);">📅 ${day}</h3>
        `;

        const dayConflicts = (conflicts && conflicts[day]) || [];
        if (dayConflicts.length > 0) {
          html += `
            <div style="background: rgba(255, 45, 149, 0.1); border-left: 4px solid var(--neon-pink); padding: 10px 12px; border-radius: 6px; margin-bottom: 12px; font-size: 13px; color: var(--text-light);">
              ⚠️ ${dayConflicts.join('<br>⚠️ ')}
            </div>
          `;
        }

        const dayTrims = (trims && trims[day]) || [];
        if (dayTrims.length > 0) {
          html += `
            <div style="background: rgba(0, 229, 255, 0.08); border-left: 4px solid var(--neon-cyan); padding: 10px 12px; border-radius: 6px; margin-bottom: 12px; font-size: 12px; color: var(--text-dim);">
              ℹ️ ${dayTrims.join('<br>ℹ️ ')}
            </div>
          `;
        }

        daySchedule.forEach(item => {
          const dh = Math.floor(item.durationMins / 60);
          const dm = item.durationMins % 60;
          const startTime = formatMinsAMPM(item.startMins);
          const duration = dh > 0 ? `${dh}h ${dm}m` : `${dm}m`;

          html += `
            <div class="schedule-item">
              <span class="schedule-time">${startTime}</span>
              <span class="schedule-activity">${item.activity}</span>
              <span class="schedule-duration">${duration}</span>
            </div>
          `;
        });

        html += '</div>';
      });

      html += '</div>';

      container.innerHTML = html;
      container.style.display = 'block';
      document.getElementById('noScheduleMessage').style.display = 'none';
      document.getElementById('regenerateBtn').style.display = 'inline-flex';
    }

    // ==================== Smart Fit Assistant ====================
    function openSmartFitModal() {
      document.getElementById('fitWakeTime').value = APP_STATE.data.preferences.wakeTime;
      document.getElementById('fitSleepHours').value = APP_STATE.data.preferences.sleepHours;
      document.getElementById('fitStudyTarget').value = APP_STATE.data.preferences.studyTarget;
      updateSmartFitPreview();
      openModal('smartFitModal');
    }

    function updateSmartFitPreview() {
      const wakeStr = document.getElementById('fitWakeTime').value || APP_STATE.data.preferences.wakeTime;
      const sleepH = parseFloat(document.getElementById('fitSleepHours').value);
      const studyH = parseFloat(document.getElementById('fitStudyTarget').value);
      const summaryEl = document.getElementById('smartFitSummary');
      const listEl = document.getElementById('fitPreviewList');

      if (!wakeStr || isNaN(sleepH) || isNaN(studyH) || sleepH <= 0 || studyH < 0) {
        summaryEl.innerHTML = 'Fill in all three fields to see a live preview.';
        listEl.innerHTML = '';
        return;
      }

      const [wh, wm] = wakeStr.split(':').map(Number);
      const wakeMins = wh * 60 + wm;
      const sleepMins = sleepH * 60;
      const studyMins = studyH * 60;
      const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

      let allFit = true;
      let rows = '';
      days.forEach(day => {
        const result = buildDaySchedule(day, wakeMins, sleepMins, studyMins, APP_STATE.data.institutions);
        const fits = result.studyShortfallMins === 0;
        if (!fits) allFit = false;
        rows += `
          <div style="display: flex; justify-content: space-between; padding: 4px 0; font-size: 13px; font-family: var(--font-mono); color: ${fits ? 'var(--neon-acid)' : 'var(--neon-pink)'};">
            <span>${day}</span>
            <span>${fits ? '✓ Fits' : '⚠ Short ' + (result.studyShortfallMins / 60).toFixed(1) + 'h'}</span>
          </div>
        `;
      });

      listEl.innerHTML = rows;
      summaryEl.innerHTML = allFit
        ? '✅ Great — your full study target fits every day with these settings.'
        : '⚠️ Some days still fall short with these settings. Keep adjusting — the preview updates live. Avoid dropping sleep below 6-7 hours.';

      if (sleepH < 6) {
        summaryEl.innerHTML += '<br>😴 Heads up: under 6 hours of sleep isn\'t recommended, even to hit a study goal.';
      }
    }

    function applySmartFit() {
      const wakeStr = document.getElementById('fitWakeTime').value;
      const sleepH = parseFloat(document.getElementById('fitSleepHours').value);
      const studyH = parseFloat(document.getElementById('fitStudyTarget').value);

      if (!wakeStr || isNaN(sleepH) || isNaN(studyH) || sleepH <= 0 || studyH < 0) {
        alert('Please fill in a valid wake time, sleep hours, and study target.');
        return;
      }

      APP_STATE.data.preferences.wakeTime = wakeStr;
      APP_STATE.data.preferences.sleepHours = sleepH;
      APP_STATE.data.preferences.studyTarget = studyH;

      // Apply the new target across every day so it stays consistent with the generator
      ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].forEach(day => {
        APP_STATE.data.timetable[day].studyHours = studyH;
      });

      updateUI();
      closeModal('smartFitModal');
      generateTimetable();
      showLightToast('Nice!', 'Smart Fit applied to your schedule');
    }

    // ==================== Focus Timer Functions ====================
    function toggleFocusMode() {
      const overlay = document.getElementById('focusOverlay');
      overlay.classList.toggle('hidden');
      if (!overlay.classList.contains('hidden')) {
        startFocusTimer(APP_STATE.data.preferences.sessionLength * 60);
      } else {
        clearInterval(APP_STATE.focusTimer.timerId);
      }
    }

    function startFocusTimer(sec) {
      clearInterval(APP_STATE.focusTimer.timerId);
      APP_STATE.focusTimer.secondsLeft = sec;
      APP_STATE.focusTimer.isPaused = false;
      updateFocusDisplay();
      APP_STATE.focusTimer.timerId = setInterval(() => {
        if (!APP_STATE.focusTimer.isPaused) {
          APP_STATE.focusTimer.secondsLeft--;
          updateFocusDisplay();
          if (APP_STATE.focusTimer.secondsLeft <= 0) {
            clearInterval(APP_STATE.focusTimer.timerId);
            celebrate(window.innerWidth / 2, window.innerHeight / 2, 45);
            toggleFocusMode();
            addStudyHour();
          }
        }
      }, 1000);
    }

    function toggleFocusTimer() {
      APP_STATE.focusTimer.isPaused = !APP_STATE.focusTimer.isPaused;
      document.getElementById('focusPlayIcon').className = APP_STATE.focusTimer.isPaused ? 'fas fa-play' : 'fas fa-pause';
    }

    function updateFocusDisplay() {
      const m = Math.floor(APP_STATE.focusTimer.secondsLeft / 60), s = APP_STATE.focusTimer.secondsLeft % 60;
      document.getElementById('focusTimerDisplay').innerText = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    // ==================== Study Tracking ====================
    function addStudyHour() {
      APP_STATE.todayHours++;
      APP_STATE.bestDayHours = Math.max(APP_STATE.bestDayHours, APP_STATE.todayHours);

      const now = new Date();
      const currentMins = now.getHours() * 60 + now.getMinutes();
      if (currentMins >= 22 * 60 || currentMins < 4 * 60) {
        APP_STATE.lastSessionWasLate = true;
      }

      if (APP_STATE.data.preferences.sleepHours >= 7) {
        APP_STATE.wellRestedStreak++;
      } else {
        APP_STATE.wellRestedStreak = 0;
      }

      updateUI();
      triggerPop('todayHours');
      showLightToast('Good Work, Keep It Up Champ!', `${APP_STATE.todayHours} hr${APP_STATE.todayHours !== 1 ? 's' : ''} studied today`);
    }

    function logTodaySession(evt) {
      const finishedStreak = APP_STATE.streak + 1;
      APP_STATE.streak = finishedStreak;
      APP_STATE.todayHours = 0;
      updateUI();
      triggerPop('streakDisplay');
      if (evt) {
        celebrate(evt.clientX, evt.clientY, 35);
      }
      showLightToast('Good Work, Keep It Up Champ!', `🔥 Streak: ${finishedStreak} day${finishedStreak !== 1 ? 's' : ''}`);
    }

    // ==================== Settings Functions ====================
    function openSettingsModal() {
      document.getElementById('modalStudyTarget').value = APP_STATE.data.preferences.studyTarget;
      document.getElementById('modalWakeTime').value = APP_STATE.data.preferences.wakeTime;
      document.getElementById('modalSessionLength').value = APP_STATE.data.preferences.sessionLength;
      openModal('settingsModal');
    }

    // Applies a flat daily study target to every day's per-day value, so the
    // generator (which reads per-day targets) stays consistent with the simple
    // "one number" settings the person sees on the Dashboard/Settings.
    function syncStudyTargetToAllDays(hours) {
      ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].forEach(day => {
        APP_STATE.data.timetable[day].studyHours = hours;
      });
    }

    function saveSettingsModal() {
      const target = parseInt(document.getElementById('modalStudyTarget').value);
      APP_STATE.data.preferences.studyTarget = target;
      APP_STATE.data.preferences.wakeTime = document.getElementById('modalWakeTime').value;
      APP_STATE.data.preferences.sessionLength = parseInt(document.getElementById('modalSessionLength').value);
      syncStudyTargetToAllDays(target);
      updateUI();
      if (APP_STATE.data.institutions.length > 0) {
        generateTimetable();
      }
      closeModal('settingsModal');
      showLightToast('Nice!', 'Settings saved');
    }

    function savePreferences() {
      APP_STATE.data.preferences.wakeTime = document.getElementById('wakeTimeInput').value;
      APP_STATE.data.preferences.sessionLength = parseInt(document.getElementById('sessionLengthInput').value);
      updateUI();
      if (APP_STATE.data.institutions.length > 0) {
        generateTimetable();
      }
      showLightToast('Nice!', 'Preferences saved');
    }

    function updateStudyTarget() {
      const target = parseInt(document.getElementById('studyTargetInput').value);
      APP_STATE.data.preferences.studyTarget = target;
      syncStudyTargetToAllDays(target);
      updateUI();
      if (APP_STATE.data.institutions.length > 0) {
        generateTimetable();
      }
      showLightToast('Nice!', 'Study target updated');
    }

    // ==================== Timetable Functions ====================
    function openTimetableModal() {
      document.getElementById('monInput').value = APP_STATE.data.timetable.Mon.studyHours;
      document.getElementById('tueInput').value = APP_STATE.data.timetable.Tue.studyHours;
      document.getElementById('wedInput').value = APP_STATE.data.timetable.Wed.studyHours;
      document.getElementById('thuInput').value = APP_STATE.data.timetable.Thu.studyHours;
      document.getElementById('friInput').value = APP_STATE.data.timetable.Fri.studyHours;
      document.getElementById('satInput').value = APP_STATE.data.timetable.Sat.studyHours;
      document.getElementById('sunInput').value = APP_STATE.data.timetable.Sun.studyHours;
      openModal('timetableModal');
    }

    function saveTimetable() {
      APP_STATE.data.timetable.Mon.studyHours = parseFloat(document.getElementById('monInput').value);
      APP_STATE.data.timetable.Tue.studyHours = parseFloat(document.getElementById('tueInput').value);
      APP_STATE.data.timetable.Wed.studyHours = parseFloat(document.getElementById('wedInput').value);
      APP_STATE.data.timetable.Thu.studyHours = parseFloat(document.getElementById('thuInput').value);
      APP_STATE.data.timetable.Fri.studyHours = parseFloat(document.getElementById('friInput').value);
      APP_STATE.data.timetable.Sat.studyHours = parseFloat(document.getElementById('satInput').value);
      APP_STATE.data.timetable.Sun.studyHours = parseFloat(document.getElementById('sunInput').value);
      updateUI();
      closeModal('timetableModal');
      showLightToast('Nice!', 'Weekly schedule updated');
    }

    // ==================== Storage Functions ====================
    function saveStateToLocalStorage() {
      localStorage.setItem('timepilot_data', JSON.stringify(APP_STATE));
    }

    function loadStateFromLocalStorage() {
      const saved = localStorage.getItem('timepilot_data');
      if (saved) {
        const loaded = JSON.parse(saved);
        APP_STATE.data = loaded.data || APP_STATE.data;
        APP_STATE.streak = loaded.streak || 0;
        APP_STATE.todayHours = loaded.todayHours || 0;
        APP_STATE.generatedTimetable = loaded.generatedTimetable || APP_STATE.generatedTimetable;
        APP_STATE.generatedSchedule = loaded.generatedSchedule || null;
        APP_STATE.bestDayHours = loaded.bestDayHours || 0;
        APP_STATE.wellRestedStreak = loaded.wellRestedStreak || 0;
        APP_STATE.lastSessionWasLate = loaded.lastSessionWasLate || false;
        APP_STATE.scheduleConflicts = loaded.scheduleConflicts || {};
        APP_STATE.scheduleTrims = loaded.scheduleTrims || {};
        APP_STATE.studyShortfalls = loaded.studyShortfalls || {};
      }
    }

    // ==================== Modal Functions ====================
    function openModal(modalId) {
      document.getElementById(modalId).classList.add('show');
    }

    function closeModal(modalId) {
      document.getElementById(modalId).classList.remove('show');
    }

    // Close modal on background click
    document.addEventListener('click', (e) => {
      if (e.target.classList.contains('modal')) {
        e.target.classList.remove('show');
      }
    });

    // ==================== Export Functions ====================
    function triggerPrintPDF() {
      window.print();
    }
  </script>
</body>
</html>
