    function addInstitution() {
      const name = document.getElementById('institutionName').value.trim();
      const type = document.getElementById('institutionType').value;
      const startTime = document.getElementById('schoolStartTime').value;
      const endTime = document.getElementById('schoolEndTime').value;
      const travelMins = Math.max(0, parseInt(document.getElementById('institutionTravelTime').value) || 0);
      const workdays = Array.from(document.querySelectorAll('.workday-check:checked')).map(cb => cb.value);

      if (!name) {
        alert('Please enter institution name');
        return;
      }
      if (workdays.length === 0) {
        alert('Please select at least one working day');
        return;
      }

      if (editingInstitutionId !== null) {
        const inst = APP_STATE.data.institutions.find(i => i.id === editingInstitutionId);
        if (inst) {
          inst.name = name;
          inst.type = type;
          inst.startTime = startTime;
          inst.endTime = endTime;
          inst.travelMins = travelMins;
          inst.workdays = workdays;
        }
        editingInstitutionId = null;
        saveStateToLocalStorage();
        renderInstitutions();
        closeModal('addInstitutionModal');
        generateTimetable();
        showLightToast('Nice!', `${name} updated`);
        return;
      }

      const institution = {
        id: Date.now(),
        name,
        type,
        startTime,
        endTime,
        travelMins,
        workdays
      };

      APP_STATE.data.institutions.push(institution);
      saveStateToLocalStorage();
      renderInstitutions();
      closeModal('addInstitutionModal');
      generateTimetable();
      showLightToast('Nice!', `${name} added to your schedule`);
    }

    function removeInstitution(id) {
      APP_STATE.data.institutions = APP_STATE.data.institutions.filter(inst => inst.id !== id);
      saveStateToLocalStorage();
      renderInstitutions();
      if (APP_STATE.data.institutions.length > 0) {
        generateTimetable();
      } else {
        document.getElementById('generatedScheduleContainer').style.display = 'none';
        document.getElementById('noScheduleMessage').style.display = 'block';
        document.getElementById('regenerateBtn').style.display = 'none';
      }
