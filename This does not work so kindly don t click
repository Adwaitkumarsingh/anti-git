    const APP_STATE = {
      data: {
        preferences: {
          wakeTime: '07:00',
          studyTarget: 4,
          sessionLength: 25,
          sleepHours: 8
        },
        timetable: {
          Mon: { studyHours: 8, sleepHours: 7 },
          Tue: { studyHours: 8, sleepHours: 7 },
          Wed: { studyHours: 8, sleepHours: 7 },
          Thu: { studyHours: 8, sleepHours: 7 },
          Fri: { studyHours: 8, sleepHours: 7 },
          Sat: { studyHours: 6, sleepHours: 8 },
          Sun: { studyHours: 6, sleepHours: 8 }
        },
        institutions: []
      },
      streak: 0,
      todayHours: 0,
      bestDayHours: 0,
      wellRestedStreak: 0,
      lastSessionWasLate: false,
      generatedTimetable: {
        Mon: { sleepHours: 7 },
        Tue: { sleepHours: 7 },
        Wed: { sleepHours: 7 },
        Thu: { sleepHours: 7 },
        Fri: { sleepHours: 7 },
        Sat: { sleepHours: 8 },
        Sun: { sleepHours: 8 }
      },
      focusTimer: {
        timerId: null,
        secondsLeft: 0,
        isPaused: false
      },
      generatedSchedule: null,
      uiInitialized: false
    };

    // Load data on page load
    window.addEventListener('load', () => {
      loadStateFromLocalStorage();
      updateUIFromState();
      evaluateBadges();
      APP_STATE.uiInitialized = true;
      renderInstitutions();
      if (APP_STATE.data.institutions.length > 0) {
        generateTimetable();
      }
      runWelcomeSequence();
    });

    // ==================== Welcome Boot Sequence ====================
    function typeText(el, text, speed) {
      return new Promise(resolve => {
        let i = 0;
        el.textContent = '';
        const interval = setInterval(() => {
          el.textContent += text[i];
          i++;
          if (i >= text.length) {
            clearInterval(interval);
            resolve();
          }
        }, speed);
      });
    }

    let welcomeSkipped = false;

    async function runWelcomeSequence() {
      const line1El = document.getElementById('welcomeLine1');
      const line2El = document.getElementById('welcomeLine2');
      const cursor1 = document.getElementById('welcomeCursor1');
      const cursor2 = document.getElementById('welcomeCursor2');
      const btn = document.getElementById('welcomeEnterBtn');
      const hint = document.querySelector('.welcome-hint');

      if (welcomeSkipped) return;
      await typeText(line1El, 'Welcome, Friend.', 55);
      if (welcomeSkipped) return;

      cursor1.style.display = 'none';
      cursor2.style.display = 'inline-block';
      await new Promise(r => setTimeout(r, 300));
      if (welcomeSkipped) return;

      await typeText(line2El, 'How can I help you today?', 32);
      cursor2.style.display = 'none';

      btn.classList.add('show');
      hint.classList.add('show');
    }

    function dismissWelcome() {
      welcomeSkipped = true;
      const overlay = document.getElementById('welcomeOverlay');
      if (!overlay || overlay.classList.contains('hide')) return;
      overlay.classList.add('hide');
      setTimeout(() => {
        overlay.style.display = 'none';
      }, 650);
    }

    // ==================== Screen Light-Up Toast ====================
    // A brief full-screen flash + glowing message card, used for celebratory
    // moments: saving credentials/settings ("Nice!") and study milestones
    // ("Good Work, Keep It Up Champ!"). Non-blocking — the app stays usable
    // underneath it, unlike a native alert().
    let lightToastTimeout = null;

    function showLightToast(mainText, subText) {
      const toast = document.getElementById('lightToast');
      const mainEl = document.getElementById('lightToastMain');
      const subEl = document.getElementById('lightToastSub');
      if (!toast || !mainEl || !subEl) return;

      mainEl.textContent = mainText;
      subEl.textContent = subText || '';
      subEl.style.display = subText ? 'block' : 'none';

      // Restart the animation even if a toast is already showing
      toast.classList.remove('show');
      void toast.offsetWidth; // force reflow
      toast.classList.add('show');

      if (lightToastTimeout) clearTimeout(lightToastTimeout);
      lightToastTimeout = setTimeout(() => {
        toast.classList.remove('show');
      }, 1900);
    }

    // ==================== Tab Navigation ====================
    function switchTab(tabName, evt) {
      const contents = document.querySelectorAll('.tab-content');
      const buttons = document.querySelectorAll('.tab-button');
      
      contents.forEach(content => content.classList.remove('active'));
      buttons.forEach(btn => btn.classList.remove('active'));
      
      document.getElementById(tabName).classList.add('active');
      if (evt) {
        evt.target.closest('.tab-button').classList.add('active');
      } else {
        const fallbackBtn = Array.from(buttons).find(btn => btn.getAttribute('onclick').includes(`'${tabName}'`));
        if (fallbackBtn) fallbackBtn.classList.add('active');
      }

      if (tabName === 'generated' && APP_STATE.generatedSchedule) {
        showLightToast("Don't Back Down Now!", 'Your Smart Fit AI Assistant has a plan for you');
      }
    }

    // ==================== Utility Functions ====================
    function timeToMins(timeStr) {
      const [h, m] = timeStr.split(':').map(Number);
      return h * 60 + m;
    }

    function minsToTime(mins) {
      const h = Math.floor(mins / 60);
      const m = mins % 60;
      return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
    }

    function updateUI() {
      updateUIFromState();
      evaluateBadges();
      saveStateToLocalStorage();
    }

    function updateUIFromState() {
      // Update quick stats
      document.getElementById('streakDisplay').innerText = `${APP_STATE.streak} days`;
      document.getElementById('wakeTimeDisplay').innerText = formatTime(APP_STATE.data.preferences.wakeTime);
      document.getElementById('studyTargetDisplay').innerText = `${APP_STATE.data.preferences.studyTarget} hrs`;
      document.getElementById('sleepHoursDisplay').innerText = `${APP_STATE.data.preferences.sleepHours} hrs`;
      document.getElementById('goalDisplay').innerText = `${APP_STATE.data.preferences.studyTarget} hour${APP_STATE.data.preferences.studyTarget !== 1 ? 's' : ''}/day`;
      
      // Update today's progress
      document.getElementById('todayHours').innerText = `${APP_STATE.todayHours} hrs`;
      const percentage = (APP_STATE.todayHours / APP_STATE.data.preferences.studyTarget) * 100;
      document.getElementById('progressFill').style.width = Math.min(percentage, 100) + '%';
      document.getElementById('progressText').innerText = `${APP_STATE.todayHours} hrs of ${APP_STATE.data.preferences.studyTarget} hrs completed`;

      // Update timetable display
      document.getElementById('mon-hours').innerText = `${APP_STATE.data.timetable.Mon.studyHours} hrs`;
      document.getElementById('tue-hours').innerText = `${APP_STATE.data.timetable.Tue.studyHours} hrs`;
      document.getElementById('wed-hours').innerText = `${APP_STATE.data.timetable.Wed.studyHours} hrs`;
      document.getElementById('thu-hours').innerText = `${APP_STATE.data.timetable.Thu.studyHours} hrs`;
      document.getElementById('fri-hours').innerText = `${APP_STATE.data.timetable.Fri.studyHours} hrs`;
      document.getElementById('sat-hours').innerText = `${APP_STATE.data.timetable.Sat.studyHours} hrs`;
      document.getElementById('sun-hours').innerText = `${APP_STATE.data.timetable.Sun.studyHours} hrs`;

      // Update input fields
      document.getElementById('wakeTimeInput').value = APP_STATE.data.preferences.wakeTime;
      document.getElementById('sessionLengthInput').value = APP_STATE.data.preferences.sessionLength;
      document.getElementById('studyTargetInput').value = APP_STATE.data.preferences.studyTarget;
    }

    function formatTime(timeStr) {
      const [h, m] = timeStr.split(':').map(Number);
      const period = h >= 12 ? 'PM' : 'AM';
      const displayH = h % 12 || 12;
      return `${displayH}:${String(m).padStart(2, '0')} ${period}`;
    }

    // Same as formatTime, but takes minutes-since-midnight (handles values that have
    // rolled past 1440 or gone negative, which the schedule generator can produce).
    function formatMinsAMPM(mins) {
      const norm = ((mins % 1440) + 1440) % 1440;
      const h = Math.floor(norm / 60);
      const m = norm % 60;
      const period = h >= 12 ? 'PM' : 'AM';
      const displayH = h % 12 || 12;
      return `${displayH}:${String(m).padStart(2, '0')} ${period}`;
    }

    // ==================== Badge Functions ====================
    function evaluateBadges() {
      const wakeM = timeToMins(APP_STATE.data.preferences.wakeTime);
      updateBadge('badgeEarlyBird', 'tagEarlyBird', wakeM <= 420);
      updateBadge('badgeStreak', 'tagStreak', APP_STATE.streak >= 1);
      updateBadge('badgeMaster', 'tagMaster', APP_STATE.data.preferences.studyTarget >= 4);
      updateBadge('badgeBalanced', 'tagBalanced', APP_STATE.data.preferences.sleepHours >= 7);
      updateBadge('badgeNightOwl', 'tagNightOwl', !!APP_STATE.lastSessionWasLate);
      updateBadge('badgeConsistency', 'tagConsistency', APP_STATE.streak >= 7);
      updateBadge('badgeMarathoner', 'tagMarathoner', APP_STATE.bestDayHours >= 3);
      updateBadge('badgeWellRested', 'tagWellRested', APP_STATE.wellRestedStreak >= 5);
      updateBadge('badgeOverachiever', 'tagOverachiever', APP_STATE.todayHours >= APP_STATE.data.preferences.studyTarget && APP_STATE.data.preferences.studyTarget > 0);
      updateBadge('badgeScholar', 'tagScholar', APP_STATE.data.institutions.length >= 2);
    }

    function updateBadge(cId, tId, unlocked) {
      const card = document.getElementById(cId), tag = document.getElementById(tId);
      const wasUnlocked = card.classList.contains('unlocked');
      card.style.opacity = unlocked ? '1' : '0.4';
      card.classList.toggle('unlocked', unlocked);
      card.classList.toggle('locked', !unlocked);
      tag.innerText = unlocked ? 'Unlocked' : 'Locked';

      if (unlocked && !wasUnlocked && APP_STATE.uiInitialized) {
        const rect = card.getBoundingClientRect();
        celebrate(rect.left + rect.width / 2, rect.top + rect.height / 2, 22);
      }
    }

    // Briefly pulses a stat value to give satisfying visual feedback when it updates
    function triggerPop(elementId) {
      const el = document.getElementById(elementId);
      if (!el) return;
      el.classList.remove('pop');
      void el.offsetWidth; // force reflow so the animation restarts if triggered again quickly
      el.classList.add('pop');
    }

    // ==================== Neon Particle Burst ====================
    // A lightweight celebration effect for milestones (badge unlocks, logging a
    // session, finishing a focus timer) — spawns a handful of glowing dots that
    // fly outward and fade, using the Web Animations API so no extra libraries
    // or persistent DOM nodes are needed.
    function celebrate(x, y, count) {
      const colors = ['#ff2d95', '#00e5ff', '#a742ff', '#ccff00'];
      const particleCount = count || 30;

      for (let i = 0; i < particleCount; i++) {
        const el = document.createElement('div');
        const size = 4 + Math.random() * 6;
        const color = colors[Math.floor(Math.random() * colors.length)];

        el.style.position = 'fixed';
        el.style.left = x + 'px';
        el.style.top = y + 'px';
        el.style.width = size + 'px';
        el.style.height = size + 'px';
        el.style.background = color;
        el.style.borderRadius = '50%';
        el.style.boxShadow = `0 0 8px ${color}, 0 0 16px ${color}`;
        el.style.pointerEvents = 'none';
        el.style.zIndex = '3000';
        document.body.appendChild(el);

        const angle = Math.random() * Math.PI * 2;
        const distance = 60 + Math.random() * 160;
        const dx = Math.cos(angle) * distance;
        const dy = Math.sin(angle) * distance - 30;
        const duration = 650 + Math.random() * 550;

        try {
          const anim = el.animate([
            { transform: 'translate(0, 0) scale(1)', opacity: 1 },
            { transform: `translate(${dx}px, ${dy}px) scale(0.2)`, opacity: 0 }
          ], { duration, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
          anim.onfinish = () => el.remove();
        } catch (e) {
          // Web Animations API unavailable — just remove the dot after a delay
          setTimeout(() => el.remove(), 800);
        }
      }
    }

    // ==================== Institution Functions ====================
    let editingInstitutionId = null;

    function openAddInstitutionModal() {
